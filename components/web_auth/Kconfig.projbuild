menu "Web Authentication"

    config WEB_AUTH_ENABLED
        bool "Enable Web Authentication"
        default y
        help
            Enable password-based authentication for the web dashboard.

    config WEB_AUTH_PBKDF2_ITERATIONS
        int "PBKDF2 iteration count"
        default 60000
        range 10000 200000
        help
            Number of PBKDF2 iterations for password hashing.
            Higher values are more secure but slower.
            Target: password verification ≤ 300ms on ESP32-S3.

    config WEB_AUTH_MAX_SESSIONS
        int "Maximum concurrent sessions"
        default 4
        range 1 16
        help
            Maximum number of concurrent browser sessions.

    config WEB_AUTH_SESSION_IDLE_MINUTES
        int "Session idle timeout (minutes)"
        default 30
        range 5 1440
        help
            Session is invalidated after this many minutes of inactivity.

    config WEB_AUTH_SESSION_MAX_HOURS
        int "Session absolute timeout (hours)"
        default 12
        range 1 720
        help
            Session is invalidated after this many hours regardless of activity.

endmenu
