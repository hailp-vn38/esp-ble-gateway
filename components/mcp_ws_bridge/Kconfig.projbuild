menu "External MCP WebSocket Bridge"

    config MCP_WS_BRIDGE
        bool "Enable external MCP WebSocket bridge"
        default y
        help
            Connect the gateway to an external MCP WebSocket broker. Runtime
            connection remains disabled until an endpoint is configured and
            enabled through Settings.

    config MCP_WS_DEFAULT_ENABLED
        bool "Enable Xiaozhi by default"
        default n
        depends on MCP_WS_BRIDGE
        help
            When enabled, the MCP WebSocket bridge starts automatically at boot
            if no user configuration is stored in NVS.  Factory firmware should
            keep this disabled so the bridge only runs when the user explicitly
            enables it through Settings.

    config MCP_WS_ALLOW_INSECURE
        bool "Allow plaintext ws:// endpoints"
        default n
        depends on MCP_WS_BRIDGE
        help
            Development/LAN only. Production endpoints should use wss://.

    config MCP_WS_MAX_RX_MESSAGE
        int "Maximum received MCP message bytes"
        range 1024 32768
        default 8192
        depends on MCP_WS_BRIDGE

    config MCP_WS_MAX_TX_MESSAGE
        int "Maximum transmitted MCP message bytes"
        range 4096 65536
        default 32768
        depends on MCP_WS_BRIDGE

    config MCP_WS_TX_FRAGMENT_SIZE
        int "WebSocket TX fragment size"
        range 512 4096
        default 1536
        depends on MCP_WS_BRIDGE
        help
            Fragment large MCP responses into bounded WebSocket frames while
            preserving one JSON-RPC response as one WebSocket message.

    config MCP_WS_PSRAM_TX_THRESHOLD
        int "Prefer PSRAM for TX payloads above this size"
        range 512 8192
        default 1024
        depends on MCP_WS_BRIDGE

    config MCP_WS_RELOAD_COOLDOWN_MS
        int "Manual reload cooldown milliseconds"
        range 0 2000
        default 250
        depends on MCP_WS_BRIDGE
        help
            Delay reconnect after destroying the old client so its TLS,
            TCP/IP, and task allocations can be released first.

    config MCP_WS_MEMORY_DIAGNOSTICS
        bool "Log bridge internal/DMA/PSRAM memory snapshots"
        default n
        depends on MCP_WS_BRIDGE
        help
            Development-only diagnostics around connect, destroy, READY, and
            TX. Keep disabled in production to avoid heap queries on hot paths.

    config MCP_WS_EVENT_QUEUE_DEPTH
        int "Bridge event queue depth"
        range 4 32
        default 8
        depends on MCP_WS_BRIDGE

    config MCP_WS_TASK_STACK
        int "Bridge worker stack bytes"
        range 4096 16384
        default 8192
        depends on MCP_WS_BRIDGE

    config MCP_WS_MAX_BACKOFF_MS
        int "Maximum reconnect backoff milliseconds"
        range 1000 300000
        default 60000
        depends on MCP_WS_BRIDGE

    config MCP_WS_HANDSHAKE_TIMEOUT_MS
        int "MCP handshake timeout milliseconds"
        range 1000 60000
        default 10000
        depends on MCP_WS_BRIDGE

endmenu
