menu "MCP Endpoint"

    choice MCP_TOOL_SURFACE
        prompt "MCP tool surface mode"
        default MCP_TOOL_SURFACE_DYNAMIC

        config MCP_TOOL_SURFACE_COMPACT
            bool "Compact semantic MCP surface (3 tools)"
            help
                Reduces the default MCP surface to exactly three tools:
                get_status, list_devices, device_control. No dynamic
                per-device tools are exposed. Ideal for Xiaozhi/AI agents.

        config MCP_TOOL_SURFACE_DYNAMIC
            bool "Legacy dynamic per-device MCP tools"
            help
                Preserves the current dynamic tool surface with per-device
                tools added from the capability catalog. Default behavior.
    endchoice

    config MCP_AUTH_TOKEN
        string "Bearer token for POST /mcp"
        default ""
        help
            Required in the Authorization header ("Bearer <token>") for every
            request. Empty disables authentication (dev mode, logged as a
            warning). The token travels over plaintext HTTP: only safe inside
            a trusted LAN.

    config MCP_HOST_ALLOWLIST
        string "Allowed Host headers (comma separated)"
        default "gateway.local,192.168.4.1"
        help
            Requests whose Host header (port stripped, IPv6 literals kept)
            is not on this list are rejected with 403 to blunt DNS rebinding.
            Entries are case-insensitive. Empty disables the check.

    config MCP_DEVICE_COMMAND_ALLOWLIST
        string "Commands allowed via the device_command tool (comma separated)"
        default ""
        help
            Comma-separated list of peripheral commands the device_command
            tool may send (e.g. "toggle,set_power"). Empty denies all device
            commands. Gateway tools are not affected by this list.

    config MCP_EXPOSE_FULL_CAPABILITY_TOOL
        bool "Expose the full device capability tool"
        default n
        help
            Adds the capability-oriented device control tool to tools/list.
            Keep disabled unless the MCP client needs this broader surface.

    config MCP_KEEP_GENERIC_DEVICE_COMMAND
        bool "Expose the legacy generic device_command tool"
        default n
        help
            Keeps the generic device_command tool for compatibility. Commands
            remain restricted by MCP_DEVICE_COMMAND_ALLOWLIST.

    config MCP_COMPAT_2025
        bool "Enable MCP 2024/2025 initialize compatibility"
        default y
        help
            Accept MCP 2024-11-05 and 2025-11-25 initialize/initialized flows
            and subsequent tools/list and tools/call requests. The server does
            not create an MCP-Session-Id and keeps no per-client protocol
            session state.

    config MCP_STRICT_ACCEPT_HEADER
        bool "Require both MCP Streamable HTTP Accept media types"
        default n
        help
            When enabled, requests must include both application/json and
            text/event-stream in the Accept header. When disabled (default),
            missing Accept or JSON-only Accept is accepted for compatibility
            with clients that do not advertise event-stream support.

    config MCP_RATE_LIMIT_RPS
        int "Sustained request rate limit (requests per second)"
        range 1 100
        default 10
        help
            Token bucket refill rate; bucket capacity is fixed at 10 requests.

    config MCP_TOOLS_CACHE_TTL_MS
        int "tools/list cache TTL in milliseconds"
        range 0 60000
        default 60000
        help
            Cache TTL sent in MCP 2026 tools/list responses. Applies to both
            static and dynamic tools/list. Default 60000 preserves existing
            behavior.

endmenu
