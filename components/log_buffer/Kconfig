menu "Log Buffer"

    config LOG_BUFFER_CAPACITY
        int "Number of log entries in ring buffer"
        default 128
        range 32 512
        help
            Number of entries in the RAM ring buffer. Each entry uses
            ~192 bytes of RAM. Default 128 = ~24KB.

    config LOG_BUFFER_TEST_HELPERS
        bool "Expose log buffer test-only helpers"
        default n
        help
            Exposes log_buffer_test_get_ring_mutex() and
            log_buffer_test_reset_metrics() so unit tests can force
            deterministic writer contention and reset metrics. Never enable
            in production firmware.

endmenu
