# ============================================================
# ESP32-S3 — Production sdkconfig.defaults
# Board: ESP32-S3 / 16 MB Flash / 8 MB OCTAL PSRAM / 512 KB SRAM
# Toolchain: ESP-IDF v6.1-rc1
# ============================================================

# ==== CPU ====
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ==== Flash ====
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ==== Partition table (OTA A/B) ====
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ==== PSRAM — 8 MB OCTAL ====
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ECC_ENABLE=y

# Allocator tuning — benchmark before freezing.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# Optional — enable only after A/B experiment with 9-link baseline:
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set

# ==== NimBLE: Central role + BLE 5.0 ====
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=9
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=16
CONFIG_BT_NIMBLE_MAX_CCCDS=16
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# ==== OTA rollback ====
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ==== Wi-Fi ====
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ==== HTTP server ====
CONFIG_HTTPD_WS_SUPPORT=n

# ==== MCP endpoint ====
CONFIG_MCP_HOST_ALLOWLIST="gateway.local,192.168.4.1,192.168.1.114"

# ==== RTOS ====
CONFIG_FREERTOS_HZ=1000
