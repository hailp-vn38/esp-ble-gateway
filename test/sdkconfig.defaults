CONFIG_ESP_TASK_WDT_EN=n
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_UNITY_ENABLE_64BIT=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Unity tests place dispatch_result_t (~4.1 KB) and other fixtures on the
# main task stack; the 3584-byte default overflows.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# ==== MCP endpoint under test ====
# Dev mode (empty token); allowlist matches the mock Host header; "toggle"
# is allowlisted so the device_command path can be exercised end-to-end.
CONFIG_MCP_AUTH_TOKEN=""
CONFIG_MCP_HOST_ALLOWLIST="gateway.local"
CONFIG_MCP_DEVICE_COMMAND_ALLOWLIST="toggle,set_power"
CONFIG_MCP_LEGACY_MODE=y

# ==== Command executor under test ====
# Short deadline so the expiry test finishes quickly on target.
CONFIG_CMD_EXEC_JOB_TIMEOUT_MS=1000

# ==== Log buffer under test ====
# Deterministic contention test needs the ring mutex handle; metric reset
# needs the test-only counter helper.
CONFIG_LOG_BUFFER_TEST_HELPERS=y

