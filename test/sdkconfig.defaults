CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_UNITY_ENABLE_64BIT=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Unity tests place large fixtures on the main task stack;
# the 3584-byte default overflows.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_WS_TRANSPORT=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# ==== MCP endpoint under test ====
# Dev mode (empty token); allowlist matches the mock Host header; "toggle"
# is allowlisted so the device_command path can be exercised end-to-end.
CONFIG_MCP_AUTH_TOKEN=""
CONFIG_MCP_HOST_ALLOWLIST="gateway.local"
CONFIG_MCP_DEVICE_COMMAND_ALLOWLIST="toggle,set_power"
CONFIG_MCP_EXPOSE_FULL_CAPABILITY_TOOL=y
CONFIG_MCP_KEEP_GENERIC_DEVICE_COMMAND=y

# ==== Board I/O under test ====
# Button on a safe input pin exercises debounce/FSM through the module;
# display capability is compiled in with the "none" backend so disabled
# semantics and fake-backend rendering are unit-testable.
CONFIG_BOARD_IO_BUTTON_ENABLE=y
CONFIG_BOARD_IO_BUTTON_GPIO=4
CONFIG_BOARD_IO_BUTTON_ACTIVE_LOW=y
CONFIG_BOARD_IO_DISPLAY_ENABLE=y
CONFIG_BOARD_IO_DISPLAY_BACKEND_NONE=y
CONFIG_BOARD_IO_DISPLAY_REQUIRED=n

# ==== MCP WS Bridge under test ====
CONFIG_MCP_WS_BRIDGE=y
CONFIG_MCP_WS_DEFAULT_ENABLED=n
CONFIG_MCP_WS_TASK_STACK=4096
